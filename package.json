{
  "name": "@local/whale-translator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Whale-mode selection translator for DeepSeek Harness: select text, pick 翻译, and get an English↔Chinese translation with the original line breaks intact.",
  "scripts": {
    "test": "node --test test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md",
    "extension/**",
    "test/*.test.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
